# Copy to ~/.config/dictation/config and set chmod 600.
#
# OpenAI key — used for transcription via gpt-4o-transcribe (best accuracy).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here

# Groq key — used for the cleanup pass via Llama 4 Scout (filler removal).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk-your_key_here
